:demoRoutine
title Diagnostic Terminal
color 0A

echo Starting diagnostics...
timeout /t 1 >nul

echo Checking virtual hardware...
timeout /t 1 >nul

for /L %%i in (1,1,8) do (
    set /a value=!random! %% 100
    echo Sensor %%i : %%value%%
    timeout /t 1 >nul
)

echo.
echo Diagnostic scan complete.
pause
goto :eof

